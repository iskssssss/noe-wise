# 至少 32 个随机字符，只提供给机构服务和 sandbox-service，绝不能传入任务容器。
SANDBOX_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-chars
SANDBOX_SERVICE_PORT=18200
SANDBOX_PYTHON_INDEX_URL=https://pypi.org/simple
SANDBOX_NODE_REGISTRY_URL=https://registry.npmjs.org
# 两个环境版本标识须与机构服务一致；变更运行镜像时同时更新版本标识。
SANDBOX_WORKFLOW_PYTHON_ENVIRONMENT_VERSION=workflow-python-v1
SANDBOX_WORKFLOW_NODE_ENVIRONMENT_VERSION=workflow-node-v1
SANDBOX_WORKFLOW_PYTHON_IMAGE=skillforge-sandbox-python:3.12
SANDBOX_WORKFLOW_NODE_IMAGE=skillforge-sandbox-node:24

# 获授权的新环境可使用独立任务卷，保留原卷作为回滚材料。
SANDBOX_TASK_VOLUME=skillforge-sandbox-tasks

# 项目卷跨任务保留，独立于临时任务目录；云端凭据通过本机环境或秘密配置注入。
SANDBOX_PROJECT_VOLUME=skillforge-sandbox-projects
SANDBOX_WORKSPACE_CLOUD_ENDPOINT=https://v0.api.upyun.com
SANDBOX_WORKSPACE_CLOUD_BUCKET=
SANDBOX_WORKSPACE_CLOUD_OPERATOR=
SANDBOX_WORKSPACE_CLOUD_PASSWORD=
# 此值是客户端统一请求速率，不是又拍云公布的服务额度。
SANDBOX_WORKSPACE_CLOUD_REQUESTS_PER_SECOND=1
