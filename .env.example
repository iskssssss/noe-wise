# ============================================
# 灵知 Java 环境配置
# ============================================
# Copy to .env and adjust for your environment.

# --- 数据库（机构服务） ---
# 本地 Compose 映射端口为 5433；其他环境显式替换目标地址。
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/skillforge
SPRING_DATASOURCE_USERNAME=skillforge_institution
SPRING_DATASOURCE_PASSWORD=skillforge_institution_dev

# --- Flyway（两个宿主必须使用同一实际对象 owner，与机构运行角色分离） ---
SPRING_FLYWAY_USER=skillforge
SPRING_FLYWAY_PASSWORD=skillforge_dev

# --- 数据库（平台运营服务，需 BYPASSRLS 角色） ---
# 与机构共享数据库地址，账号只读取 PLATFORM_DATASOURCE_*，不回退机构账号。
# PLATFORM_DATASOURCE_PASSWORD 必填：使用该角色的独立密码，无公开默认值。
# 生产环境由 DBA 创建独立角色；对象和默认授权使用 deploy/pg-init/roles/runtime-grants.sql。
PLATFORM_DATASOURCE_USERNAME=skillforge_platform
PLATFORM_DATASOURCE_PASSWORD=

# --- Redis ---
# 机构 Runtime 空闲轮询；缩短可减少等待，同时增加数据库查询频率。
AGENT_RUNTIME_WORKER_POLL_INTERVAL=100ms

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DATABASE=0

# --- LLM ---
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# --- 安全 ---
# 必填：为两个宿主配置同一独立随机主密钥，至少32字符；不要使用公开占位符。
SECRET_KEY=
# 可选：最多4个历史解密主密钥的标准Base64，逗号分隔；默认空，不用于新加密/JWT。
# 两个宿主必须配置相同值。Base64不是保密措施，历史弱/公开key的旧密文风险不会消失。
SECRET_KEY_DECRYPTION_KEYS=
# 平台 JWT 签名密钥；与 SECRET_KEY 独立。两个宿主配置同一值，机构仅在平台部署管理入口验证它。
PLATFORM_SECRET_KEY=

# --- 平台初始管理员（仅平台账号表为空时生效；启动前设置独立密码） ---
PLATFORM_ADMIN_USERNAME=platform-admin
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=

# --- Nacos / 服务发现 ---
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_DISCOVERY_ENABLED=false
NACOS_CONFIG_ENABLED=false

# --- 应用 ---
SKILLFORGE_MODEL_MEDIA_ROOT=./data/model-media
INSTITUTION_SERVICE_PORT=8000
PLATFORM_SERVICE_PORT=8100
GATEWAY_PORT=8080
# 认证前非 multipart 请求缓存的原始字节硬限，默认 8MiB；独立于文件上传/form 限制
HTTP_MAX_CACHED_BODY_SIZE=8MB
SKILLFORGE_DEBUG=true
