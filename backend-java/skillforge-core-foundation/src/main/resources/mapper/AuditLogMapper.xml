<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.skillforge.core.foundation.persistence.AuditLogMapper">
    <resultMap id="auditLog" type="com.skillforge.core.foundation.persistence.AuditLogDO" autoMapping="true">
        <id column="id" property="id"/>
        <result column="payload" property="payload" typeHandler="com.skillforge.core.shared.config.JsonbTypeHandler"/>
    </resultMap>
    <select id="selectLogs" resultMap="auditLog">
        SELECT id, tenant_id, actor_id, action, resource_type, resource_id, message, trace_id, payload, created_at FROM nw_audit_logs
        <where>
            <if test="tenantId != null">tenant_id = #{tenantId}</if>
            <if test="query.action != null and query.action != ''">AND action = #{query.action}</if>
            <if test="query.actorId != null and query.actorId != ''">AND actor_id = #{query.actorId}</if>
            <if test="query.resourceType != null and query.resourceType != ''">AND resource_type = #{query.resourceType}</if>
            <if test="query.from != null">AND created_at &gt;= #{query.from}</if>
            <if test="query.to != null">AND created_at &lt; #{query.to}</if>
        </where>
        ORDER BY created_at DESC, id DESC
    </select>
</mapper>
