<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.skillforge.institution.workflow.WorkflowInstallReceiptMapper">
  <insert id="insert">INSERT INTO nw_workflow_install_receipts(tenant_id,request_id,actor_ref,workflow_id,instance_id,revision)
    VALUES(#{tenant},CAST(#{requestId} AS uuid),#{actor},#{workflowId},#{instanceId},#{revision})</insert>
  <select id="find" resultType="com.skillforge.institution.workflow.WorkflowInstallReceiptMapper$Row">
    SELECT instance_id,revision FROM nw_workflow_install_receipts WHERE tenant_id=#{tenant}
      AND request_id=CAST(#{requestId} AS uuid) AND actor_ref=#{actor} AND workflow_id=#{workflowId}
  </select>
</mapper>
