<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.skillforge.institution.runtime.RuntimeStorageTenants">
    <select id="page" resultType="java.lang.String">
        SELECT id::text FROM public.nw_tenants WHERE id &gt; CAST(#{after} AS bigint) ORDER BY id LIMIT #{limit}
    </select>
</mapper>
