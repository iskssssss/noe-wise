<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.skillforge.runtime.adapter.jdbc.session.SessionPreparationsMapper">
    <select id="bindTenant" resultType="string">SELECT set_config('app.tenant_id',#{tenant},true)</select>
    <select id="lockProfile" resultType="string">SELECT pg_advisory_xact_lock(hashtextextended('session-preparation-profile:'||current_setting('app.tenant_id',true)||':'||#{ref},0))::text</select>
    <select id="profile" resultType="string">SELECT profile_data FROM public.agent_runtime_session_preparation_profiles WHERE tenant_id=current_setting('app.tenant_id',true) AND profile_ref=#{ref}</select>
    <insert id="insertProfile">INSERT INTO public.agent_runtime_session_preparation_profiles(tenant_id,profile_ref,profile_data) VALUES(current_setting('app.tenant_id',true),#{ref},#{data})</insert>
</mapper>
