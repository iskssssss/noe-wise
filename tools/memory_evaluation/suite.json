{
  "schemaVersion": 1,
  "suiteId": "noewise-memory-v1",
  "repeats": 3,
  "language": "zh-CN",
  "budget": {
    "maxTokens": 1000000,
    "maxSeconds": 7200
  },
  "scenarios": [
    {
      "id": "M01",
      "name": "问候不保存",
      "mode": "NO_SAVE",
      "setupMessages": [
        "你好，谢谢你的帮助。"
      ],
      "probe": "",
      "expected": {
        "noFact": true
      }
    },
    {
      "id": "M02",
      "name": "临时约束不成为长期偏好",
      "mode": "TEMPORARY",
      "setupMessages": [
        "这次请把通知写成五条，每条不超过二十个字。这个格式只用于今天这份通知。"
      ],
      "probe": "",
      "expected": {
        "noPreference": true
      }
    },
    {
      "id": "M03",
      "name": "明确保存助手专属长期偏好",
      "mode": "EXPLICIT_SAVE",
      "setupMessages": [
        "请长期记住：以后为我整理业务说明，默认先列三点结论，再解释细节。这是我的跨任务习惯。"
      ],
      "probe": "请按照我以前约定的格式，简要说明新员工如何办理入职。",
      "expected": {
        "factText": [
          "结论"
        ],
        "answerAll": [
          "结论"
        ],
        "scope": "USER_AGENT",
        "factStatus": "ACTIVE"
      }
    },
    {
      "id": "M04",
      "name": "计划时间与不确定性保真",
      "mode": "EPISODE",
      "setupMessages": [
        "我计划在2027年3月18日去苏州拜访供应商，行程还没确认，也还没有出发。"
      ],
      "probe": "之前提到的供应商拜访是什么安排，现在进行到什么程度了？",
      "expected": {
        "factText": [
          "2027",
          "苏州"
        ],
        "answerAll": [
          "苏州"
        ],
        "answerNone": [
          "已经完成拜访"
        ],
        "scope": "USER_AGENT",
        "factStatus": "ACTIVE"
      }
    },
    {
      "id": "M05",
      "name": "第三方引用不归属于本人",
      "mode": "THIRD_PARTY",
      "setupMessages": [
        "同事林澄说：“我以后想把例会安排在周五下午。”这是他个人的想法，我还没有提出自己的会议偏好。"
      ],
      "probe": "我的例会安排偏好是什么？",
      "expected": {
        "noPreference": true,
        "answerNone": [
          "你偏好周五下午",
          "你喜欢周五下午"
        ]
      }
    },
    {
      "id": "M06",
      "name": "明确保存所有助手共享偏好",
      "mode": "SHARED",
      "setupMessages": [
        "请所有助手长期记住：给我写业务通知时，默认使用中文简体；这是跨任务通用偏好。"
      ],
      "probe": "请按我以前约定的语言习惯，写一句新员工欢迎语。",
      "expected": {
        "factText": [
          "中文"
        ],
        "scope": "USER",
        "factStatus": "ACTIVE"
      }
    },
    {
      "id": "M07",
      "name": "同会话最新信息覆盖旧信息",
      "mode": "SAME_SESSION",
      "setupMessages": [
        "这次采购预算是3000元，先不用做方案。",
        "预算已改为3500元，之后这次采购都按新预算处理。"
      ],
      "probe": "这次采购的最终预算是多少？",
      "expected": {
        "answerAll": [
          "3500"
        ],
        "answerNone": [
          "预算是3000"
        ]
      }
    },
    {
      "id": "M08",
      "name": "新会话自然召回",
      "mode": "CROSS_SESSION",
      "setupMessages": [
        "请长期记住：以后供应商沟通优先安排在周四上午，这是一项长期安排偏好。"
      ],
      "probe": "供应商想预约一次沟通，请按我以前的习惯推荐时间。",
      "expected": {
        "factText": [
          "周四"
        ],
        "answerAll": [
          "周四",
          "上午"
        ],
        "scope": "USER_AGENT",
        "factStatus": "ACTIVE"
      }
    },
    {
      "id": "M09",
      "name": "改述问题召回",
      "mode": "PARAPHRASE",
      "setupMessages": [
        "请长期记住：以后业务报告里的金额默认用人民币元，并且保留两位小数。"
      ],
      "probe": "请按我以往的金额展示习惯写出3128.5的费用，不要解释。",
      "expected": {
        "factText": [
          "小数"
        ],
        "answerAll": [
          "3128.50"
        ],
        "scope": "USER_AGENT",
        "factStatus": "ACTIVE"
      }
    },
