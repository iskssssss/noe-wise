{
  "entry": {"language": "python", "script_path": "scripts/generate_configuration.py"},
  "expects_typed_results": true,
  "dependencies": [
    {"name": "PyYAML", "version": "6.0.2"},
    {"name": "jsonschema", "version": "4.25.1"},
    {"name": "attrs", "version": "25.3.0"},
    {"name": "jsonschema-specifications", "version": "2025.9.1"},
    {"name": "referencing", "version": "0.36.2"},
    {"name": "rpds-py", "version": "0.27.1"},
    {"name": "typing-extensions", "version": "4.16.0"}
  ],
  "example_inputs": ["examples/configuration.json", "examples/configuration-file.json"],
  "outputs": {
    "json": ["configuration.json"],
    "yaml": ["configuration.yaml"],
    "zip": ["configuration.zip"]
  }
}
