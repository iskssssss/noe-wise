{
  "html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>项目需求报告</title><style>*{box-sizing:border-box}body{margin:0;font:16px system-ui;color:#18302b;background:#f5f1e8}main{max-width:1000px;margin:auto;padding:clamp(20px,5vw,64px)}h1{font-size:clamp(28px,6vw,56px)}label{display:block;margin:24px 0 12px}input{padding:10px;width:100%;max-width:400px}table{width:100%;border-collapse:collapse}td,th{padding:12px;border-bottom:1px solid #b7c3bd;text-align:left;overflow-wrap:anywhere}@media(max-width:500px){td,th{padding:8px}}</style></head><body><main><p>项目计划 · 数据快照</p><h1>企业服务需求报告</h1><label>筛选需求 <input id=\"filter\" type=\"search\" placeholder=\"按需求文字筛选\"></label><p id=\"count\" aria-live=\"polite\">2 项需求</p><table><thead><tr><th scope=\"col\">需求</th><th scope=\"col\">状态</th></tr></thead><tbody><tr><td>企业本地部署及权限配置</td><td>待确认</td></tr><tr><td>数据备份与恢复演练</td><td>规划中</td></tr></tbody></table></main><script>const rows=[...document.querySelectorAll('tbody tr')];document.getElementById('filter').addEventListener('input',e=>{let count=0;rows.forEach(row=>{row.hidden=!row.textContent.includes(e.target.value);if(!row.hidden)count++});document.getElementById('count').textContent=count+' 项需求'});</script></body></html>"
}
